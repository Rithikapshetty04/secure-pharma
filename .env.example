# Secure Pharma Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/secure_pharma

# JSON Web Token Secret Key & Lifetime
JWT_SECRET=securepharma_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Base URL for CORS Configuration
FRONTEND_URL=http://localhost:5173

# License Upload Directory & File Limits
UPLOAD_DIR=uploads/licenses
MAX_FILE_SIZE=5242880
